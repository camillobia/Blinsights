# Copie para .env (nunca versione o .env). Em produção, cadastre no painel do Render.
# Use o mesmo banco configurado no BackEnd/.env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change-me
# require para Neon/Azure; disable para PostgreSQL local sem SSL
DB_SSLMODE=require
# Mesmo valor de ETL_API_KEY do backend
ETL_API_KEY=replace-with-the-same-value-used-by-the-backend
