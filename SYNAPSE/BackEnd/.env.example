# Copy this file to .env and replace the placeholders with your Azure PostgreSQL settings.
DB_URL=jdbc:postgresql://your-server.postgres.database.azure.com:5432/postgres?sslmode=require
DB_USER=your_azure_database_user
DB_PASSWORD=your_azure_database_password
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173