# Copie para .env (nunca versione o .env). Em produção, cadastre estas variáveis no painel do Render.

# ---- Banco PostgreSQL (Neon ou Azure) ----
# Neon:  jdbc:postgresql://HOST.neon.tech/BANCO?sslmode=require
# Azure: jdbc:postgresql://SERVIDOR.postgres.database.azure.com:5432/BANCO?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USER=postgres
DB_PASSWORD=change-me
# Opcional: tamanho do pool de conexões (padrão 5; o Neon gratuito tem limite)
# DB_POOL_SIZE=5

# ---- Segurança ----
# Pelo menos 32 caracteres aleatórios. Gere com: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Endereços do front-end que podem chamar a API, separados por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Administrador criado automaticamente na primeira inicialização ----
ADMIN_EMAIL=admin@blinsights.local
ADMIN_PASSWORD=troque-esta-senha

# ---- Integração com o serviço Python (ETL) ----
# Sem barra no final; o backend chama ETL_URL + /etl
ETL_URL=http://localhost:8000
ETL_API_KEY=replace-with-the-same-value-used-by-analytics-python

# ---- Porta (o Render define automaticamente) ----
# PORT=8080
